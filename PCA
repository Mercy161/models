# ============================================
# 3. ALS BASELINE CORRECTION
# ============================================
def als_baseline(y, lam=1e5, p=0.01, niter=10):

    L = len(y)

    D = sparse.diags(
        [1, -2, 1],
        [0, -1, -2],
        shape=(L, L - 2)
    )

    w = np.ones(L)

    for _ in range(niter):

        W = sparse.spdiags(w, 0, L, L)

        Z = W + lam * (D @ D.T)

        z = spsolve(Z, w * y)

        w = p * (y > z) + (1 - p) * (y < z)

    return z

# ============================================
# 4. DESPIKING
# ============================================
def despike(y, z_thresh=5):

    y_med = np.median(y)

    y_std = np.std(y)

    spikes = np.abs(y - y_med) > z_thresh * y_std

    y2 = y.copy()

    y2[spikes] = y_med

    return y2

# ============================================
# 5. NORMALIZATION
# ============================================
def normalize_vector(y):

    norm = np.linalg.norm(y)

    if norm == 0:
        norm = 1e-9

    return y / norm

# ============================================
# 6. PREPROCESS FUNCTION
# ============================================
def preprocess(y):

    # Despike
    y1 = despike(y)

    # Baseline correction
    baseline = als_baseline(y1)

    y2 = y1 - baseline

    # Savitzky-Golay smoothing
    y3 = savgol_filter(y2, 11, 3)

    # Normalize
    y4 = normalize_vector(y3)

    return y4

# ============================================
# 7. PREPROCESS ALL SPECTRA (entire range)
# ============================================
processed_spectra = []

for i in range(spectra.shape[1]):

    y = spectra[:, i]

    y_p = preprocess(y)

    processed_spectra.append(y_p)

processed_spectra = np.array(processed_spectra)   # shape (n_samples, n_wavelengths)

print("\nProcessed Spectra Shape:")
print(processed_spectra.shape)

# ============================================
# 8. DEFINE FUNCTION FOR PCA + OUTLIER REMOVAL + PLOTTING + METRICS
# ============================================
def pca_analysis(spectra_matrix, groups, sample_names, wavelength_range_name,
                 wavelength_axis=None, ax=None):
    """
    Perform PCA on given spectra_matrix (samples x wavelengths) after standardization.
    Remove outliers using Mahalanobis distance (95% chi2 threshold).
    Plot score plot on provided axis (or create new one) and return metrics.
    """
    # Standardize variables (wavelengths)
    scaler = StandardScaler()
    X_scaled = scaler.fit_transform(spectra_matrix)

    # PCA with 2 components
    pca = PCA(n_components=2)
    scores = pca.fit_transform(X_scaled)
    expl_var = pca.explained_variance_ratio_ * 100

    print(f"\n--- {wavelength_range_name} ---")
    print(f"PC1 variance: {expl_var[0]:.2f}%")
    print(f"PC2 variance: {expl_var[1]:.2f}%")

    # Outlier removal based on Mahalanobis distance in PCA space
    threshold = np.sqrt(chi2.ppf(0.95, df=2))
    outliers = []

    for g in np.unique(groups):
        idxs = np.where(groups == g)[0]
        if len(idxs) < 3:
            continue
        group_scores = scores[idxs]
        mean = np.mean(group_scores, axis=0)
        cov = np.cov(group_scores, rowvar=False)
        # Regularize covariance if singular
        if np.linalg.matrix_rank(cov) < 2:
            cov += np.eye(2) * 1e-6
        inv_cov = np.linalg.inv(cov)
        for idx_sample, point in zip(idxs, group_scores):
            d = mahalanobis(point, mean, inv_cov)
            if d > threshold:
                outliers.append(idx_sample)

    print(f"Outliers removed: {len(outliers)}")
    if len(outliers) > 0:
        print("Removed samples:")
        for i in outliers:
            print(f"  {sample_names[i]}")

    # Clean data
    scores_clean = np.delete(scores, outliers, axis=0)
    groups_clean = np.delete(groups, outliers)
    sample_names_clean = np.delete(sample_names, outliers)

    # Compute separation metrics
    unique_groups = np.unique(groups_clean)
    centroids = {}
    within_distances = []

    for g in unique_groups:
        idx = np.where(groups_clean == g)[0]
        cent = np.mean(scores_clean[idx], axis=0)
        centroids[g] = cent
        # Average Euclidean distance of points to centroid
        dists = np.linalg.norm(scores_clean[idx] - cent, axis=1)
        within_distances.append(np.mean(dists))

    # Between-group distances (Euclidean between centroids)
    between_distances = {}
    for i, g1 in enumerate(unique_groups):
        for g2 in unique_groups[i+1:]:
            d = np.linalg.norm(centroids[g1] - centroids[g2])
            between_distances[f"{g1}–{g2}"] = d

    # Separation index: average between-group distance / average within-group distance
    avg_between = np.mean(list(between_distances.values()))
    avg_within = np.mean(within_distances)
    separation_index = avg_between / avg_within if avg_within > 0 else np.inf

    # Plotting
    if ax is None:
        fig, ax = plt.subplots(figsize=(6,5))

    colors = {"Standard": "#1f77b4", "Within-expiry": "#ff7f0e",
              "Post-expiry": "#2ca02c", "Unknown": "#d62728"}

    for g in unique_groups:
        idx = np.where(groups_clean == g)[0]
        ax.scatter(scores_clean[idx, 0], scores_clean[idx, 1],
                   s=80, alpha=0.9, color=colors.get(g, "gray"), label=g)

        # Confidence ellipse (95%)
        if len(idx) >= 3:
            x = scores_clean[idx, 0]
            y = scores_clean[idx, 1]
            cov_xy = np.cov(x, y)
            mean_xy = [np.mean(x), np.mean(y)]
            eigvals, eigvecs = np.linalg.eigh(cov_xy)
            order = eigvals.argsort()[::-1]
            eigvals = eigvals[order]
            eigvecs = eigvecs[:, order]
            angle = np.degrees(np.arctan2(*eigvecs[:, 0][::-1]))
            ell = Ellipse(xy=mean_xy,
                          width=2 * np.sqrt(eigvals[0] * 5.991),
                          height=2 * np.sqrt(eigvals[1] * 5.991),
                          angle=angle, edgecolor=colors.get(g, "gray"),
                          fc='None', lw=2, ls='--')
            ax.add_patch(ell)

    ax.set_xlabel(f"PC1 ({expl_var[0]:.2f}%)", fontsize=12)
    ax.set_ylabel(f"PC2 ({expl_var[1]:.2f}%)", fontsize=12)
    ax.set_title(wavelength_range_name, fontsize=14)
    ax.grid(True, linestyle="--", alpha=0.4)
    ax.legend()

    return {
        "scores_clean": scores_clean,
        "groups_clean": groups_clean,
        "expl_var": expl_var,
        "separation_index": separation_index,
        "avg_between": avg_between,
        "avg_within": avg_within,
        "between_distances": between_distances
    }

